# Postgres (Supabase, Neon, Prisma Postgres, or any Postgres)
# Pooled connection used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct (non-pooled) connection used by `prisma migrate`
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Optional: which account the single-user app reads/writes (default: loser@test.com)
MACROTRACK_USER_EMAIL="loser@test.com"

# Optional: AI meal estimates (https://aistudio.google.com/apikey)
GEMINI_API_KEY=""

# Set to "true" for a public portfolio deploy: demo mode only, the database is never touched.
NEXT_PUBLIC_DEMO_ONLY="false"
